{
  "name": "DeadLake",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DeadLake": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/shared"
        },
        "Remotes": {
          "$className": "Folder",
          "ToServer": {
            "$className": "RemoteEvent"
          },
          "ToClient": {
            "$className": "RemoteEvent"
          }
        },
        "GameState": {
          "$className": "Folder"
        },
        "Assets": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DeadLake": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DeadLake": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "EnableMouseLockOption": false
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 0,
        "Brightness": 0.75,
        "Ambient": [
          0.1,
          0.11,
          0.15
        ],
        "OutdoorAmbient": [
          0.26,
          0.29,
          0.38
        ],
        "ColorShift_Top": [
          0.55,
          0.62,
          0.8
        ],
        "FogColor": [
          0.08,
          0.09,
          0.12
        ],
        "FogStart": 6,
        "FogEnd": 220,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 0.15,
        "ExposureCompensation": 0.35,
        "ShadowSoftness": 0.3
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.15,
          "Color": [
            0.42,
            0.46,
            0.58
          ],
          "Decay": [
            0.2,
            0.22,
            0.3
          ],
          "Glare": 0,
          "Haze": 1.8
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": -0.3,
          "Contrast": 0.08,
          "Brightness": 0.03,
          "TintColor": [
            0.82,
            0.88,
            1.0
          ]
        }
      }
    }
  }
}

{
  "name": "DeadLake",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DeadLake": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/shared"
        },
        "Remotes": {
          "$className": "Folder",
          "ToServer": {
            "$className": "RemoteEvent"
          },
          "ToClient": {
            "$className": "RemoteEvent"
          }
        },
        "GameState": {
          "$className": "Folder"
        },
        "Assets": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DeadLake": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DeadLake": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "EnableMouseLockOption": false
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 0,
        "Brightness": 0.4,
        "Ambient": [
          0.02,
          0.023,
          0.032
        ],
        "OutdoorAmbient": [
          0.05,
          0.058,
          0.08
        ],
        "ColorShift_Top": [
          0.55,
          0.62,
          0.8
        ],
        "FogColor": [
          0.03,
          0.035,
          0.045
        ],
        "FogStart": 6,
        "FogEnd": 115,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.15,
        "EnvironmentSpecularScale": 0.15,
        "ExposureCompensation": -0.3,
        "ShadowSoftness": 0.3
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.55,
          "Offset": 0.1,
          "Color": [
            0.3,
            0.33,
            0.4
          ],
          "Decay": [
            0.1,
            0.11,
            0.15
          ],
          "Glare": 0,
          "Haze": 3.5
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": -0.35,
          "Contrast": 0.12,
          "Brightness": -0.02,
          "TintColor": [
            0.82,
            0.88,
            1.0
          ]
        }
      }
    }
  }
}
